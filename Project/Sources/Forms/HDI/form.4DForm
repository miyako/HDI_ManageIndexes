{
  "$4d": {
    "version": "1",
    "kind": "form"
  },
  "destination": "detailScreen",
  "windowSizingX": "fixed",
  "windowSizingY": "fixed",
  "width": 724,
  "height": 560,
  "menuBar": "Main Bar",
  "events": [
    "onLoad"
  ],
  "method": "method.4dm",
  "pages": [
    {
      "objects": {
        "Rectangle1": {
          "type": "rectangle",
          "top": 0,
          "left": 0,
          "width": 724,
          "height": 560,
          "sizingX": "grow",
          "sizingY": "grow",
          "stroke": "transparent",
          "fill": "automatic"
        },
        "Rectangle": {
          "type": "rectangle",
          "top": 110,
          "left": 0,
          "width": 724,
          "height": 364,
          "stroke": "transparent",
          "class": "hdi-panel"
        }
      }
    },
    {
      "objects": {
        "Icon4D": {
          "type": "picture",
          "top": 24,
          "left": 30,
          "width": 64,
          "height": 64,
          "pictureFormat": "scaled",
          "picture": "/RESOURCES/4D.png"
        },
        "txtHowDoI": {
          "type": "text",
          "top": 20,
          "left": 160,
          "width": 544,
          "height": 37,
          "stroke": "automatic",
          "textAlign": "left",
          "fontFamily": "System Font",
          "fontSize": 30,
          "text": ":xliff:HDI_HowDoI"
        },
        "txtTitle": {
          "type": "text",
          "top": 58,
          "left": 160,
          "width": 544,
          "height": 50,
          "stroke": "automatic",
          "textAlign": "left",
          "fontFamily": "System Font",
          "fontSize": 18,
          "text": ":xliff:HDI_Title"
        },
        "HDIpicture": {
          "type": "picture",
          "top": 110,
          "left": 0,
          "width": 724,
          "height": 364,
          "pictureFormat": "scaled",
          "picture": "/RESOURCES/Images/getindex.png"
        },
        "White90": {
          "type": "picture",
          "top": 110,
          "left": 0,
          "width": 724,
          "height": 364,
          "visibility": "hidden",
          "pictureFormat": "tiled",
          "picture": "Images/White90.png"
        },
        "labelVersion": {
          "type": "text",
          "top": 486,
          "left": 20,
          "width": 100,
          "height": 17,
          "stroke": "automatic",
          "textAlign": "right",
          "fontWeight": "bold",
          "text": ":xliff:HDI_LabelVersion"
        },
        "TxtVersion": {
          "type": "text",
          "top": 486,
          "left": 130,
          "width": 300,
          "height": 17,
          "text": ":xliff:HDI_TxtVersion",
          "class": "hdi-muted"
        },
        "labelInfo": {
          "type": "text",
          "top": 509,
          "left": 20,
          "width": 100,
          "height": 17,
          "stroke": "automatic",
          "textAlign": "right",
          "fontWeight": "bold",
          "text": ":xliff:HDI_LabelInfo"
        },
        "txtInfo": {
          "type": "input",
          "top": 509,
          "left": 130,
          "width": 460,
          "height": 17,
          "dataSource": "Form.info",
          "focusable": false,
          "fill": "transparent",
          "borderStyle": "none",
          "enterable": false,
          "dragging": "none",
          "dropping": "custom",
          "events": [
            "onClick"
          ],
          "class": "hdi-muted"
        },
        "labelBlog": {
          "type": "text",
          "top": 532,
          "left": 20,
          "width": 100,
          "height": 17,
          "stroke": "automatic",
          "textAlign": "right",
          "fontWeight": "bold",
          "text": ":xliff:HDI_LabelBlog"
        },
        "txtBlog": {
          "type": "input",
          "top": 532,
          "left": 130,
          "width": 460,
          "height": 17,
          "dataSource": "Form.blog",
          "textDecoration": "underline",
          "focusable": false,
          "fill": "transparent",
          "borderStyle": "none",
          "enterable": false,
          "dragging": "none",
          "dropping": "custom",
          "method": "ObjectMethods/txtBlog.4dm",
          "events": [
            "onClick"
          ],
          "class": "hdi-link"
        },
        "BtnDemo": {
          "type": "button",
          "top": 520,
          "left": 614,
          "width": 90,
          "action": "Accept",
          "shortcutKey": "[Return]",
          "text": ":xliff:HDI_BtnDemo",
          "class": "default",
          "focusable": false,
          "defaultButton": true,
          "events": [
            "onClick"
          ],
          "method": "ObjectMethods/BtnDemo.4dm"
        },
        "ErrorMainText": {
          "type": "text",
          "top": 198,
          "left": 132,
          "width": 460,
          "height": 110,
          "visibility": "hidden",
          "textAlign": "center",
          "fontTheme": "main",
          "text": ":xliff:HDI_ErrorMain",
          "class": "hdi-error"
        },
        "ErrorSubText": {
          "type": "text",
          "top": 306,
          "left": 182,
          "width": 360,
          "height": 80,
          "visibility": "hidden",
          "textAlign": "center",
          "text": ":xliff:HDI_ErrorSub",
          "class": "hdi-error"
        }
      }
    }
  ]
}